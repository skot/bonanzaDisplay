# -----------------------------------------------------------------------------
# Build directories
# -----------------------------------------------------------------------------
/build/
/build-*/
/cmake-build-*/
/out/

# CMake and Ninja generated files (for accidental in-source builds)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
compile_commands.json
build.ninja
.ninja_deps
.ninja_log
_deps/

# -----------------------------------------------------------------------------
# Pico SDK firmware and compiler artifacts
# -----------------------------------------------------------------------------
*.uf2
*.elf
*.elf.map
*.bin
*.hex
*.dis
*.lst
*.o
*.obj
*.a
*.d

# Generated PIO headers belong in the build directory
*.pio.h

# -----------------------------------------------------------------------------
# LVGL Editor preview/runtime caches
# Keep ui/*_gen.c, ui/*_gen.h, converted assets, and file_list_gen.cmake tracked.
# -----------------------------------------------------------------------------
/ui/preview-bin/
/ui/preview-build/

# -----------------------------------------------------------------------------
# Editors, operating systems, logs, and temporary files
# -----------------------------------------------------------------------------
.DS_Store
._*
.idea/
.vscode/
*.log
*.tmp
*.temp
*.swp
*.swo
*~

# Local environment overrides
.env
.env.*
!.env.example
